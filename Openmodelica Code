    model OxygenManifold "Manifold with stoichiometric supply and pressure-regulating outlet"
      parameter Real V_O2 = 0.02 "Manifold volume, m3";
      Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K";
      parameter Integer N_cells = 455 "Number of cells consuming O2";
      parameter Real lambda_O2 = 2.0 "Stoichiometric excess ratio (typically higher for air)";
      parameter Real p_target_O2 = 21278.25 "Target manifold pressure, Pa (0.21 x 101325)";
      parameter Real k_out_O2 = 2e-5 "Outlet flow coefficient, mol/(s.Pa)";
      Modelica.Blocks.Interfaces.RealInput I "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
      Real p_O2(start = 21278.25, fixed = true) "O2 partial pressure, Pa";
      Real n_dot_O2_react "O2 consumption rate, mol/s";
      Real n_dot_O2_in "O2 supply rate, mol/s (stoichiometric)";
      Real n_dot_O2_out "O2 outlet/purge rate, mol/s";
    equation
      n_dot_O2_react = N_cells*I/(4*PEMFuelCell.Functions.F);
      n_dot_O2_in = lambda_O2*n_dot_O2_react;
      n_dot_O2_out = max(0, k_out_O2*(p_O2 - p_target_O2));
      der(p_O2) = (PEMFuelCell.Functions.R*T/V_O2)*(n_dot_O2_in - n_dot_O2_react - n_dot_O2_out);
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "O2 Manifold")}));
    end OxygenManifold;

    model ThermalMass
      parameter Real C_th = 40000 "Thermal capacitance, J/K";
      parameter Real E_tn = 1.481 "Thermoneutral voltage per cell, V";
      parameter Real epsilon = 0.8 "Heat exchanger effectiveness";
      parameter Real m_dot_cool = 0.18 "Coolant mass flow rate, kg/s";
      parameter Real cp_cool = 4180 "Coolant specific heat capacity, J/(kg.K)";
      parameter Real T_cool_in = 298.15 "Coolant inlet temperature, K";
      parameter Integer N_cells = 455 "Number of cells in stack";
      Modelica.Blocks.Interfaces.RealInput I "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, 30}, {-100, 50}})));
      Modelica.Blocks.Interfaces.RealInput V_cell "Cell voltage, V" annotation(
        Placement(transformation(extent = {{-120, -50}, {-100, -30}})));
      Real T(start = 353.15, fixed = true) "Stack temperature, K";
      Real Q_gen "Heat generated, W";
      Real Q_cool "Heat removed by coolant, W";
    equation
      Q_gen = N_cells*I*(E_tn - V_cell);
      Q_cool = epsilon*m_dot_cool*cp_cool*(T - T_cool_in);
      der(T) = (Q_gen - Q_cool)/C_th;
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "Thermal Mass")}));
    end ThermalMass;

    package URFC
      block PolarizationCurveBlockURFC "Sign-aware polarisation block: I>0 fuel cell mode, I<0 electrolysis mode"
        extends Modelica.Electrical.Analog.Interfaces.OnePort;
        parameter Real i0 = 1e-3 "Exchange current density [A/m2]";
        parameter Real E0 = 1.229 "Standard reversible cell potential at reference state [V]";
        parameter Real R_ohmic = 0.15e-4 "Area-specific internal/ohmic resistance [Ohm.m2]";
        parameter Real R_conc = 1e-6 "Area-specific mass-transport/concentration resistance [Ohm.m2]";
        Modelica.Blocks.Interfaces.RealInput T "Operating temperature [K]" annotation(
          Placement(transformation(extent = {{-120, 70}, {-100, 90}})));
        Modelica.Blocks.Interfaces.RealInput i_density "Signed current density [A/m2]" annotation(
          Placement(transformation(extent = {{-120, 30}, {-100, 50}})));
        Modelica.Blocks.Interfaces.RealInput p_H2 "Hydrogen partial pressure [Pa]" annotation(
          Placement(transformation(extent = {{-120, -50}, {-100, -30}})));
        Modelica.Blocks.Interfaces.RealInput p_O2 "Oxygen partial pressure [Pa]" annotation(
          Placement(transformation(extent = {{-120, -90}, {-100, -70}})));
        Modelica.Blocks.Interfaces.RealInput p_H2O "Water vapor partial pressure [Pa]" annotation(
          Placement(transformation(extent = {{-120, -130}, {-100, -110}})));
        Modelica.Blocks.Interfaces.RealOutput V_cell "Calculated cell potential [V]" annotation(
          Placement(transformation(extent = {{100, -10}, {120, 10}})));
        Real E_nernst "Thermodynamic Nernst potential [V]";
        Real dV_act "Activation overpotential loss [V]";
        Real dV_ohmic "Ohmic overpotential loss [V]";
        Real dV_conc "Concentration/mass-transport overpotential loss [V]";
      equation
        E_nernst = PEMFuelCell.Functions.nernstVoltage(T, p_H2, p_O2, p_H2O, E0);
        dV_act = PEMFuelCell.Functions.activationLossURFC(i_density, i0, T);
        dV_ohmic = i_density*R_ohmic;
        dV_conc = PEMFuelCell.Functions.concentrationLossLinearURFC(i_density, R_conc);
        V_cell = E_nernst - dV_act - dV_ohmic - dV_conc;
      end PolarizationCurveBlockURFC;

      model HydrogenManifoldURFC
        Modelica.Blocks.Interfaces.RealInput T;
        parameter Real V_H2 = 0.005 "Hydrogen manifold volume [m3]";
        parameter Integer N_cells = 455 "Number of cells in the URFC stack [-]";
        parameter Real lambda_H2 = 1.5 "Hydrogen stoichiometry/excess ratio in fuel cell mode [-]";
        parameter Real p_target_H2 = 151987.5 "Target operating pressure for hydrogen [Pa]";
        parameter Real k_out_H2 = 2e-5 "Storage/venting valve coefficient in electrolysis mode [mol/(s.Pa)]";
        Modelica.Blocks.Interfaces.RealInput I "Signed stack current, A";
        Real p_H2(start = 151987.5, fixed = true) "Reaction molar flow rate";
        Real n_dot_H2_react "Signed: positive = consumption (FC), negative = generation (EC)";
        Real n_dot_H2_in "Supply, active only in fuel cell mode";
        Real n_dot_H2_out "Storage/venting, active only in electrolysis mode";
      equation
        n_dot_H2_react = N_cells*I/(2*PEMFuelCell.Functions.F);
        n_dot_H2_out = noEvent(max(0, k_out_H2*(p_H2 - p_target_H2)));
        n_dot_H2_in = lambda_H2*noEvent(max(n_dot_H2_react, 0));
        der(p_H2) = (PEMFuelCell.Functions.R*T/V_H2)*(n_dot_H2_in - n_dot_H2_react - n_dot_H2_out);
      end HydrogenManifoldURFC;

      model WaterManifoldURFC
        parameter Real V_H2O = 0.01 "Manifold volume, m3";
        Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K";
        parameter Integer N_cells = 455 "Number of cells";
        parameter Real p_target_H2O = 47375 "Target manifold pressure, Pa";
        parameter Real k_vent_H2O = 2e-5 "Venting coefficient, FC mode (removes excess product water), mol/(s.Pa)";
        parameter Real k_supply_H2O = 2e-5 "Supply coefficient, EC mode (feeds water for electrolysis), mol/(s.Pa)";
        Modelica.Blocks.Interfaces.RealInput I "Signed stack current, A" annotation(
          Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
        Real p_H2O(start = 101325, fixed = true) "H2O partial pressure, Pa";
        Real n_dot_H2O_react "Signed: negative = generation (FC), positive = consumption (EC)";
        Real n_dot_H2O_vent "Removal of excess product water - active in FC mode";
        Real n_dot_H2O_supply "Feed of reactant water - active in EC mode";
      equation
        n_dot_H2O_react = -N_cells*I/(2*PEMFuelCell.Functions.F);
// (FC mode, product accumulating)
        n_dot_H2O_vent = noEvent(max(0, k_vent_H2O*(p_H2O - p_target_H2O)));
        n_dot_H2O_supply = noEvent(max(0, k_supply_H2O*(p_target_H2O - p_H2O)));
        der(p_H2O) = (PEMFuelCell.Functions.R*T/V_H2O)*(n_dot_H2O_supply - n_dot_H2O_react - n_dot_H2O_vent);
      end WaterManifoldURFC;

      model OxygenManifoldURFC
        parameter Real V_O2 = 0.01 "Manifold volume, m3";
        Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K";
        parameter Integer N_cells = 455 "Number of cells";
        parameter Real lambda_O2 = 2.0 "Stoichiometric excess ratio, fuel cell mode";
        parameter Real p_target_O2 = 21278.25 "Target manifold pressure, Pa";
        parameter Real k_out_O2 = 2e-5 "Outlet/storage flow coefficient, mol/(s.Pa)";
        Modelica.Blocks.Interfaces.RealInput I "Signed stack current, A" annotation(
          Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
        Real p_O2(start = 21278.25, fixed = true) "O2 partial pressure, Pa";
        Real n_dot_O2_react "Signed: positive = consumption (FC), negative = generation (EC)";
        Real n_dot_O2_in "Gas-phase supply - active only in fuel cell mode";
        Real n_dot_O2_out "Outlet/storage flow";
      equation
        n_dot_O2_react = N_cells*I/(4*PEMFuelCell.Functions.F);
        n_dot_O2_in = lambda_O2*noEvent(max(n_dot_O2_react, 0));
        n_dot_O2_out = noEvent(max(0, k_out_O2*(p_O2 - p_target_O2)));
        der(p_O2) = (PEMFuelCell.Functions.R*T/V_O2)*(n_dot_O2_in - n_dot_O2_react - n_dot_O2_out);
      end OxygenManifoldURFC;

      model ThermalMassURFC
