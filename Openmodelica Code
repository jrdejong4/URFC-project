      model BidirectionalConverterControlled
        parameter Real L = 5e-3 "Converter energy storage filter inductance [H]";
        parameter Real C = 5e-4 "DC bus filtering capacitance [F]";
        parameter Real Kp = 1e-2 "Proportional gain for current control loop [1/A]";
        parameter Real d_min = 0.01 "Lower duty cycle limit";
        parameter Real d_max = 0.99 "Upper duty cycle limit";
        Modelica.Electrical.Analog.Interfaces.PositivePin p annotation(
          Placement(transformation(extent = {{-110, -10}, {-90, 10}})));
        Modelica.Electrical.Analog.Interfaces.NegativePin n annotation(
          Placement(transformation(extent = {{90, -10}, {110, 10}})));
        Modelica.Electrical.Analog.Interfaces.PositivePin bus_p annotation(
          Placement(transformation(extent = {{-10, 90}, {10, 110}})));
        Modelica.Electrical.Analog.Interfaces.NegativePin bus_n annotation(
          Placement(transformation(extent = {{-10, -110}, {10, -90}})));
        Modelica.Blocks.Interfaces.RealInput I_cmd "Commanded stack current, A (signed)" annotation(
          Placement(transformation(extent = {{-20, -20}, {20, 20}}, rotation = 90, origin = {-100, -100})));
        Real iL(start = 0, fixed = true) "Inductor current, A";
        Real Vstack "Stack terminal voltage, V";
        Real Vbus(start = 600, fixed = true) "Bus voltage, V";
        Real d(start = 0.5) "Duty cycle, controlled";
        Real I_actual "Actual stack current, A";
        Real error "Current tracking error";
      protected
        Real d_ff "Feedforward duty cycle based on terminal voltage ratio";
      equation
        Vstack = p.v - n.v;
        Vbus = bus_p.v - bus_n.v;
        p.i + n.i = 0;
        bus_p.i + bus_n.i = 0;
        p.i = iL;
        I_actual = iL;
        error = I_cmd - I_actual;
        d_ff = 1 - max(Vstack, 1e-3)/max(Vbus, 1);
        d = noEvent(min(max(d_ff + Kp*error, d_min), d_max));
        L*der(iL) = Vstack - (1 - d)*Vbus;
        C*der(Vbus) = (1 - d)*iL - bus_p.i;
      end BidirectionalConverterControlled;

