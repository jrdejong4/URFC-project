        parameter Real A_cell = 0.03;
        parameter Real i0 = 1e-3;
        parameter Real alpha = 0.5;
        parameter Real E0 = 1.229;
        parameter Real R_ohmic = 0.15e-4;
        parameter Real R_conc = 1e-6 "Mass-transport resistance, Ohm.m2";
        Modelica.Blocks.Interfaces.RealInput T annotation(
          Placement(transformation(extent = {{-120, 70}, {-100, 90}})));
        Modelica.Blocks.Interfaces.RealInput p_H2 annotation(
          Placement(transformation(extent = {{-120, -50}, {-100, -30}})));
        Modelica.Blocks.Interfaces.RealInput p_O2 annotation(
          Placement(transformation(extent = {{-120, -90}, {-100, -70}})));
        Modelica.Blocks.Interfaces.RealInput p_H2O annotation(
          Placement(transformation(extent = {{-120, 70}, {-100, 30}})));
        Modelica.Blocks.Interfaces.RealOutput V_cell annotation(
          Placement(transformation(extent = {{120, 70}, {100, 30}})));
        Real i_density;
        Real E_nernst;
        Real dV_act;
        Real dV_ohmic;
        Real dV_conc;
      protected
        Real c;
      equation
        i_density = -i/A_cell;
        c = PEMFuelCell.Functions.R*T/(2*PEMFuelCell.Functions.F);
        E_nernst = PEMFuelCell.Functions.nernstVoltage(T, max(p_H2, 1e-5), max(p_O2, 1e-5), max(p_H2O, 1e-5), E0);
        dV_act = PEMFuelCell.Functions.activationLossURFC(i_density, i0, T);
        dV_ohmic = i_density*R_ohmic;
        dV_conc = PEMFuelCell.Functions.concentrationLossLinearURFC(i_density, R_conc);
        v = N_cells*(E_nernst - dV_act - dV_ohmic - dV_conc);
        V_cell = v/N_cells;
      end PEMStackOnePortURFC;

