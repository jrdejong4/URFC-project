package PEMFuelCell
  package Functions
    constant Real R = Modelica.Constants.R "Universal gas constant, J/(mol.K)";
    constant Real F = 96485.33212 "Faraday's constant, C/mol";

    function nernstVoltage "Reversible cell voltage. Pressures given in Pa."
      input Real T "K";
      input Real p_H2 "Pa";
      input Real p_O2 "Pa";
      input Real p_H2O "Pa";
      input Real E0 "Standard potential at 298K, V";
      output Real E;
    protected
      Real E0_T;
      constant Real p_std = 101325 "Standard pressure, Pa";
      Real p_H2_safe;
      Real p_O2_safe;
      Real p_H2O_safe;
    algorithm
      E0_T := E0 - 0.85e-3*(T - 298.15);
// Prevent domain errors (log of <=0 or sqrt of <0)
      p_H2_safe := max(p_H2, 1.0);
      p_O2_safe := max(p_O2, 1.0);
      p_H2O_safe := max(p_H2O, 1.0);
      E := E0_T + (R*T)/(2*F)*log((p_H2_safe/p_std)*sqrt(p_O2_safe/p_std)/(p_H2O_safe/p_std));
    end nernstVoltage;

    function activationLoss
      input Real i "current density, A/m2";
      input Real i0 "exchange current density";
      input Real b "Tafel slope, V";
      output Real dV;
    algorithm
      dV := b*log(i/i0);
    end activationLoss;

    function concentrationLoss
      input Real i;
      input Real iL "limiting current density";
      input Real c "= R*T/(n*F)";
      output Real dV;
    algorithm
      dV := c*log(iL/max((iL - i), 1e-3));
    end concentrationLoss;

    function activationOverpotentialBV
      input Real i "Signed current density, A/m2";
      input Real i0 "Exchange current density, A/m2";
      input Real alpha "Charge transfer coefficient";
      input Real T "Temperature, K";
      output Real eta "Signed activation overpotential, V";
    protected
      constant Real n = 2;
    algorithm
      if abs(alpha - 0.5) < 1e-10 then
        eta := 2*PEMFuelCell.Functions.R*T/(n*PEMFuelCell.Functions.F)*Modelica.Math.asinh(i/(2*i0));
      else
// Fallback: Tafel approximation for non-0.5 alpha
        eta := PEMFuelCell.Functions.R*T/(alpha*n*PEMFuelCell.Functions.F)*log(1 + abs(i)/i0)*sign(i);
      end if;
    end activationOverpotentialBV;

    function concentrationLossURFC
      input Real i_density;
      input Real iL;
      input Real c;
      output Real dV_conc;
    protected
      Real arg;
    algorithm
//safety boundary of 1e-5 to prevent log(0)
      arg := max(1 - abs(i_density)/iL, 1e-5);
      dV_conc := -c*log(arg);
    end concentrationLossURFC;

    function activationLossURFC "Log-free Butler-Volmer activation overpotential valid for all i"
      input Real i "Signed current density, A/m2";
      input Real i0 "Exchange current density, A/m2";
      input Real T "Temperature, K";
      output Real eta "Signed activation overpotential, V";
    algorithm
      eta := 2*PEMFuelCell.Functions.R*T/(2*PEMFuelCell.Functions.F)*Modelica.Math.asinh(i/(2*i0));
    end activationLossURFC;

    function concentrationLossLinearURFC "Log-free mass-transfer resistance model valid for all i"
      input Real i "Signed current density, A/m2";
      input Real R_conc "Mass transport area-specific resistance, Ohm.m2";
      output Real dV_conc "Signed concentration loss, V";
    algorithm
      dV_conc := i*R_conc;
    end concentrationLossLinearURFC;
  end Functions;

  package Models
    block ThermalManagementSystem " reusable thermal subsystem"
      parameter Real C_th = 40000 "Thermal capacitance, J/K";
      parameter Real E_tn = 1.481 "Thermoneutral voltage per cell, V";
      parameter Real epsilon = 0.8 "Heat exchanger effectiveness";
      parameter Real m_dot_cool = 0.18 "Coolant mass flow rate, kg/s";
      parameter Real cp_cool = 4180 "Coolant specific heat capacity, J/(kg.K)";
      parameter Real T_cool_in = 298.15 "Coolant inlet temperature, K";
      parameter Integer N_cells = 455 "Number of cells in stack";
      Modelica.Blocks.Interfaces.RealInput I_stack "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, 30}, {-100, 50}})));
      Modelica.Blocks.Interfaces.RealInput V_cell_in "Cell voltage, V" annotation(
        Placement(transformation(extent = {{-120, -50}, {-100, -30}})));
      Modelica.Blocks.Interfaces.RealOutput T_out "Stack temperature, K" annotation(
        Placement(transformation(extent = {{100, -10}, {120, 10}})));
      PEMFuelCell.Models.ThermalMass thermal(C_th = C_th, E_tn = E_tn, epsilon = epsilon, m_dot_cool = m_dot_cool, cp_cool = cp_cool, T_cool_in = T_cool_in, N_cells = N_cells);
    equation
      connect(I_stack, thermal.I);
      connect(V_cell_in, thermal.V_cell);
      T_out = thermal.T;
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "Thermal Mgmt")}));
    end ThermalManagementSystem;

    block AirSupplySystem
      parameter Real V_O2 = 0.02 "Manifold volume, m3";
      Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K" annotation(
        Placement(transformation(extent = {{-120, 70}, {-100, 90}})));
      parameter Integer N_cells = 455 "Number of cells consuming O2";
      parameter Real lambda_O2 = 2.0 "Stoichiometric excess ratio";
      parameter Real p_target_O2 = 21278.25 "Target manifold pressure, Pa";
      parameter Real k_out_O2 = 2e-5 "Outlet flow coefficient, mol/(s.Pa)";
      Modelica.Blocks.Interfaces.RealInput I_stack "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
      Modelica.Blocks.Interfaces.RealOutput p_O2_out "O2 partial pressure, Pa" annotation(
        Placement(transformation(extent = {{100, -10}, {120, 10}})));
      PEMFuelCell.Models.OxygenManifold manifold(V_O2 = V_O2, N_cells = N_cells, lambda_O2 = lambda_O2, p_target_O2 = p_target_O2, k_out_O2 = k_out_O2);
    equation
      connect(I_stack, manifold.I);
      connect(T, manifold.T);
      p_O2_out = manifold.p_O2;
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "Air Supply")}));
    end AirSupplySystem;

    block HydrogenSupplySystem
      parameter Real V_H2 = 0.01 "Manifold volume, m3";
      Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K" annotation(
        Placement(transformation(extent = {{-120, 70}, {-100, 90}})));
      parameter Integer N_cells = 455 "Number of cells drawing H2";
      parameter Real lambda_H2 = 1.5 "Stoichiometric excess ratio";
      parameter Real p_target_H2 = 151987.5 "Target manifold pressure, Pa";
      parameter Real k_out_H2 = 2e-5 "Outlet flow coefficient, mol/(s.Pa)";
      Modelica.Blocks.Interfaces.RealInput I_stack "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
      Modelica.Blocks.Interfaces.RealOutput p_H2_out "H2 partial pressure, Pa" annotation(
        Placement(transformation(extent = {{100, -10}, {120, 10}})));
      PEMFuelCell.Models.HydrogenManifold manifold(V_H2 = V_H2, N_cells = N_cells, lambda_H2 = lambda_H2, p_target_H2 = p_target_H2, k_out_H2 = k_out_H2);
    equation
      connect(I_stack, manifold.I);
      connect(T, manifold.T);
      p_H2_out = manifold.p_H2;
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "H2 Supply")}));
    end HydrogenSupplySystem;

    block PolarizationCurveBlock
      Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K" annotation(
        Placement(transformation(extent = {{-120, 70}, {-100, 90}})));
      Modelica.Blocks.Interfaces.RealInput p_O2 "O2 partial pressure, Pa" annotation(
        Placement(transformation(extent = {{-120, -90}, {-100, -70}})));
      parameter Real p_H2O = 101325 "H2O partial pressure, Pa";
      Modelica.Blocks.Interfaces.RealInput i_density "Current density, A/m2" annotation(
        Placement(transformation(extent = {{-120, 30}, {-100, 50}})));
      Modelica.Blocks.Interfaces.RealInput p_H2 "H2 partial pressure, Pa" annotation(
        Placement(transformation(extent = {{-120, -50}, {-100, -30}})));
      Modelica.Blocks.Interfaces.RealOutput V_cell(start = 1.0, fixed = true) "Cell voltage, V" annotation(
        Placement(transformation(extent = {{100, -10}, {120, 10}})));
      parameter Real i0 = 1e-3 "Exchange current density, A/m2";
      parameter Real alpha = 0.5 "Charge transfer coefficient";
      parameter Real E0 = 1.229 "Standard reversible potential at 298K, V";
      parameter Real R_ohmic = 0.15e-4 "Ohmic area-specific resistance, Ohm.m2";
      parameter Real iL = 15000 "Limiting current density, A/m2";
      parameter Real tau = 2 "Voltage relaxation time constant, s";
      Real V_cell_static "Instantaneous (algebraic) cell voltage, V";
      Real E_nernst "Reversible voltage, V";
      Real b "Tafel slope, V";
      Real c "Concentration loss coefficient, V";
      Real dV_act "Activation voltage loss, V";
      Real dV_ohmic "Ohmic voltage loss, V";
      Real dV_conc "Concentration voltage loss, V";
    equation
      E_nernst = PEMFuelCell.Functions.nernstVoltage(T, p_H2, p_O2, p_H2O, E0);
      b = PEMFuelCell.Functions.R*T/(alpha*2*PEMFuelCell.Functions.F);
      c = PEMFuelCell.Functions.R*T/(2*PEMFuelCell.Functions.F);
      dV_act = PEMFuelCell.Functions.activationLoss(i_density, i0, b);
      dV_ohmic = i_density*R_ohmic;
      dV_conc = PEMFuelCell.Functions.concentrationLoss(i_density, iL, c);
      V_cell_static = E_nernst - dV_act - dV_ohmic - dV_conc;
      tau*der(V_cell) = V_cell_static - V_cell;
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "Pol.curve")}));
    end PolarizationCurveBlock;

    model NernstOnly "Step 1: reversible (open-circuit) voltage only, no losses, no current"
      parameter Real T = 353.15 "Operating temperature, K (353.15 K = 80 degC)";
      parameter Real p_H2 = 151987.5 "H2 partial pressure, atm";
      parameter Real p_O2 = 101325 "O2 partial pressure, atm";
      parameter Real p_H2O = 101325 "H2O partial pressure, atm";
      parameter Real E0 = 1.229 "Standard reversible potential at 298K, V";
      Real E "Reversible cell voltage, V";
    equation
      E = PEMFuelCell.Functions.nernstVoltage(T, p_H2, p_O2, p_H2O, E0);
    end NernstOnly;

    model OhmicLoss "Step 3: Nernst voltage minus activation loss minus ohmic loss"
      parameter Real T = 353.15 "Operating temperature, K";
      parameter Real p_H2 = 151987.5 "H2 partial pressure, Pa";
      parameter Real p_O2 = 101325 "O2 partial pressure, Pa";
      parameter Real p_H2O = 101325 "H2O partial pressure, Pa";
      parameter Real i = 5000 "Current density, A/m2";
      parameter Real i0 = 1e-3 "Exchange current density, A/m2";
      parameter Real E0 = 1.229 "Standard reversible potential at 298K, V";
      parameter Real alpha = 0.5 "Charge transfer coefficient";
      parameter Real R_ohmic = 0.15e-4 "Ohmic area-specific resistance, Ohm.m2";
      Real E_nernst "Reversible voltage, V";
      Real b "Tafel slope, V";
      Real dV_act "Activation voltage loss, V";
      Real dV_ohmic "Ohmic voltage loss, V";
      Real V_cell "Cell voltage after activation and ohmic losses, V";
    equation
      E_nernst = PEMFuelCell.Functions.nernstVoltage(T, p_H2, p_O2, p_H2O, E0);
      b = PEMFuelCell.Functions.R*T/(alpha*2*PEMFuelCell.Functions.F);
      dV_act = PEMFuelCell.Functions.activationLoss(i, i0, b);
      dV_ohmic = i*R_ohmic;
      V_cell = E_nernst - dV_act - dV_ohmic;
    end OhmicLoss;

    model PolarizationCurve
      parameter Real T = 353.15 "Operating temperature, K";
      parameter Real p_H2 = 151987.5 "H2 partial pressure, Pa";
      parameter Real p_O2 = 101325 "O2 partial pressure, Pa";
      parameter Real p_H2O = 101325 "H2O partial pressure, Pa";
      parameter Real E0 = 1.04 "Standard reversible potential at 298K, V";
      parameter Real i = 5000 "Current density, A/m2";
      parameter Real i0 = 1e-3 "Exchange current density, A/m2";
      parameter Real alpha = 0.5 "Charge transfer coefficient";
      parameter Real R_ohmic = 0.15e-4 "Ohmic area-specific resistance, Ohm.m2";
      parameter Real iL = 15000 "Limiting current density, A/m2";
      Real E_nernst "Reversible voltage, V";
      Real b "Tafel slope, V";
      Real c "Concentration loss coefficient, V";
      Real dV_act "Activation voltage loss, V";
      Real dV_ohmic "Ohmic voltage loss, V";
      Real dV_conc "Concentration voltage loss, V";
      Real V_cell "Cell voltage after all losses, V";
    equation
      E_nernst = PEMFuelCell.Functions.nernstVoltage(T, p_H2, p_O2, p_H2O, E0);
      b = PEMFuelCell.Functions.R*T/(alpha*2*PEMFuelCell.Functions.F);
      c = PEMFuelCell.Functions.R*T/(2*PEMFuelCell.Functions.F);
      dV_act = PEMFuelCell.Functions.activationLoss(i, i0, b);
      dV_ohmic = i*R_ohmic;
      dV_conc = PEMFuelCell.Functions.concentrationLoss(i, iL, c);
      V_cell = E_nernst - dV_act - dV_ohmic - dV_conc;
    end PolarizationCurve;

    model PEMCell
      extends Modelica.Electrical.Analog.Interfaces.OnePort;
      parameter Real T = 353.15 "Operating temperature, K";
      parameter Real p_H2 = 151987.5 "H2 partial pressure, Pa";
      parameter Real p_O2 = 101325 "O2 partial pressure, Pa";
      parameter Real p_H2O = 101325 "H2O partial pressure, Pa";
      parameter Real i0 = 1e-3 "Exchange current density, A/m2";
      parameter Real E0 = 1.229 "Standard reversible potential at 298K, V";
      parameter Real alpha = 0.5 "Charge transfer coefficient";
      parameter Real R_ohmic = 0.15e-4 "Ohmic area-specific resistance, Ohm.m2";
      parameter Real iL = 15000 "Limiting current density, A/m2";
      parameter Real A_cell = 0.01 "Active cell area, m2";
      PEMFuelCell.Models.PolarizationCurveBlock polCurve(T = T, p_H2 = p_H2, p_O2 = p_O2, p_H2O = p_H2O, E0 = E0, i0 = i0, alpha = alpha, R_ohmic = R_ohmic, iL = iL);
    equation
      polCurve.i_density = i/A_cell;
// electrical current -> current density, into the block
      v = polCurve.V_cell;
// block's voltage output -> electrical voltage
    end PEMCell;

    model PEMStack
      extends Modelica.Electrical.Analog.Interfaces.OnePort;
      parameter Integer N_cells = 455;
      parameter Real T = 353.15;
      parameter Real p_O2 = 101325;
      parameter Real p_H2O = 101325;
      parameter Real E0 = 1.229;
      parameter Real i0 = 1e-3;
      parameter Real alpha = 0.5;
      parameter Real R_ohmic = 0.15e-4;
      parameter Real iL = 15000;
      parameter Real A_cell = 0.01;
      parameter Real n_dot_H2_in = 0.5 "H2 supply rate, mol/s";
      Modelica.Blocks.Sources.RealExpression currentSignal(y = i);
      Modelica.Blocks.Sources.RealExpression currentDensitySignal(y = i/A_cell);
      PEMFuelCell.Models.HydrogenSupplySystem h2supply(N_cells = N_cells);
      PEMFuelCell.Models.PolarizationCurveBlock polCurve(T = T, p_O2 = p_O2, p_H2O = p_H2O, E0 = E0, i0 = i0, alpha = alpha, R_ohmic = R_ohmic, iL = iL);
    equation
      connect(currentSignal.y, h2supply.I_stack);
      connect(h2supply.p_H2_out, polCurve.p_H2);
      connect(currentDensitySignal.y, polCurve.i_density);
      v = N_cells*polCurve.V_cell;
    end PEMStack;

    model HydrogenManifold "Manifold with stoichiometric supply and pressure-regulating outlet"
      parameter Real V_H2 = 0.01 "Manifold volume, m3";
      Modelica.Blocks.Interfaces.RealInput T "Operating temperature, K";
      parameter Integer N_cells = 455 "Number of cells drawing H2";
      parameter Real lambda_H2 = 1.5 "Stoichiometric excess ratio";
      parameter Real p_target_H2 = 151987.5 "Target manifold pressure, Pa";
      parameter Real k_out_H2 = 2e-5 "Outlet flow coefficient, mol/(s.Pa)";
      Modelica.Blocks.Interfaces.RealInput I "Stack current, A" annotation(
        Placement(transformation(extent = {{-120, -10}, {-100, 10}})));
      Real p_H2(start = 151987.5, fixed = true) "H2 partial pressure, Pa";
      Real n_dot_H2_react "H2 consumption rate, mol/s";
      Real n_dot_H2_in "H2 supply rate, mol/s (stoichiometric)";
      Real n_dot_H2_out "H2 outlet/purge rate, mol/s";
    equation
      n_dot_H2_react = N_cells*I/(2*PEMFuelCell.Functions.F);
      n_dot_H2_in = lambda_H2*n_dot_H2_react;
      n_dot_H2_out = max(0, k_out_H2*(p_H2 - p_target_H2));
      der(p_H2) = (PEMFuelCell.Functions.R*T/V_H2)*(n_dot_H2_in - n_dot_H2_react - n_dot_H2_out);
      annotation(
        Icon(coordinateSystem(preserveAspectRatio = false, extent = {{-100, -100}, {100, 100}}), graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, fillColor = {230, 230, 230}, fillPattern = FillPattern.Solid), Text(extent = {{-90, 20}, {90, -20}}, textString = "H2 Manifold")}));
    end HydrogenManifold;

