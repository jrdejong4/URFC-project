def main(argv=None):
    global SHOW_PLOTS

    parser = argparse.ArgumentParser(description="Run the URFC thesis figures.")
    parser.add_argument("figures", nargs="*", help="figure keys to run (default: all)")
    parser.add_argument("--list", action="store_true", help="list the figures and exit")
    parser.add_argument("--no-show", action="store_true",
                        help="save the figures without opening windows")
    args, _ = parser.parse_known_args(argv)

    if args.list:
        for key, (title, _) in FIGURES.items():
            print(f"{key:9s} {title}")
        return 0

    unknown = [k for k in args.figures if k not in FIGURES]
    if unknown:
        parser.error(f"unknown figure(s): {', '.join(unknown)} "
                     f"(available: {', '.join(FIGURES)})")

    SHOW_PLOTS = not args.no_show
    selected = args.figures or list(FIGURES)

    failures = {}
    for key in selected:
        title, func = FIGURES[key]
        print(f"\n=== Figure {key}: {title} ===")
        try:
            func()
        except Exception as exc:    # keep going; report at the end
            traceback.print_exc()
            failures[key] = exc
            plt.close("all")

    print("\n=== Summary ===")
    print(f"Figures saved in: {OUTPUT_DIR}")
    for key in selected:
        status = f"FAILED ({failures[key]})" if key in failures else "ok"
        print(f"  {key:9s} {status}")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
