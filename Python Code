RUN_NAMES = [f"GasRun{i}.csv" for i in range(1, 6)]
GASRUN_URL_TEMPLATE = (
    "https://raw.githubusercontent.com/floorzagwijn/pem-fuelcell-thesis/"
    "main/data_raw/electrolysis_gas/{name}"
)
GASRUN_LOCAL_DIRS = [".", os.path.join("data_raw", "electrolysis_gas")]

ONSET_THRESHOLD_A = 0.05  # thesis convention: onset = first |I| > 50 mA
COMMON_DT = 0.5            # s, resampling step for averaging across runs

def find_file(name, dirs):
    for d in dirs:
        path = os.path.join(d, name)
        if os.path.isfile(path):
            return path
    return None


def load_sim_csv():
    path = next((p for p in SIM_CSV_CANDIDATES if os.path.isfile(p)), None)
    if path is None:
        raise FileNotFoundError(
            "Simulation result CSV not found. Checked: " + ", ".join(SIM_CSV_CANDIDATES)
        )
    df = pd.read_csv(path)

    def pick(df, keywords):
        for col in df.columns:
            lc = col.lower()
            if all(k in lc for k in keywords):
                return col
        return None

    time_col = pick(df, ["time"]) or df.columns[0]
    v_col = pick(df, ["v_model"]) or pick(df, ["v_stack"]) or pick(df, ["v_cell"])
    i_col = pick(df, ["i_stack"]) or pick(df, ["current"])

    if v_col is None or i_col is None:
        raise KeyError(
            f"Could not find voltage/current columns in sim CSV. "
            f"Available columns: {list(df.columns)}"
        )

    sim = pd.DataFrame({
        "time": df[time_col].astype(float),
        "voltage": df[v_col].astype(float),
        "current": df[i_col].astype(float),
    })
    return sim

def load_one_gasrun(name):
    path = find_file(name, GASRUN_LOCAL_DIRS)
    if path is not None:
        df = pd.read_csv(path)
    else:
        tmp_path = f"{name}_downloaded.csv"
        url = GASRUN_URL_TEMPLATE.format(name=name)
        urllib.request.urlretrieve(url, tmp_path)
        df = pd.read_csv(tmp_path)

    df = df.rename(columns={"Voltage": "voltage", "Current": "current", "Time": "time"})
    return df[["time", "voltage", "current"]].astype(float)


def align_to_onset(df, threshold=ONSET_THRESHOLD_A):
    above = df.index[df["current"].abs() > threshold]
    if len(above) == 0:
        return df
    t0 = df.loc[above[0], "time"]
    out = df.copy()
    out["time"] = out["time"] - t0
    return out[out["time"] >= 0].reset_index(drop=True)


def average_runs(runs, dt=COMMON_DT):
    """Resample each aligned run onto a common grid and average."""
    t_max = min(r["time"].max() for r in runs)
    t_grid = np.arange(0, t_max, dt)

    v_stack = np.full((len(runs), len(t_grid)), np.nan)
    i_stack = np.full((len(runs), len(t_grid)), np.nan)

    for k, r in enumerate(runs):
        v_stack[k] = np.interp(t_grid, r["time"], r["voltage"])
        i_stack[k] = np.interp(t_grid, r["time"], r["current"])

    avg = pd.DataFrame({
        "time": t_grid,
        "voltage": np.nanmean(v_stack, axis=0),
        "current": np.nanmean(i_stack, axis=0),
    })
    return avg

def main():
    sim = align_to_onset(load_sim_csv())

    runs = [align_to_onset(load_one_gasrun(name)) for name in RUN_NAMES]
    ref = average_runs(runs)
    t_max = min(sim["time"].max(), ref["time"].max())
    sim = sim[sim["time"] <= t_max]
    ref = ref[ref["time"] <= t_max]

    v_model_interp = np.interp(ref["time"], sim["time"], sim["voltage"])
    v_diff = v_model_interp - ref["voltage"]

    fig, axes = plt.subplots(3, 1, figsize=(8, 10), sharex=True)

    ax1 = axes[0]
    ax1.plot(ref["time"], ref["voltage"], label="Real (mean of 5 runs)", color="tab:blue")
    ax1.plot(sim["time"], sim["voltage"], label="Model", color="tab:orange")
    ax1.set_ylabel("Cell voltage (V)")
    ax1.legend()
    ax1.set_title("Electrolysis voltage: model vs. reference (5-run average, Figure 14 comparison)")

    ax2 = axes[1]
    ax2.plot(ref["time"], v_diff, color="tab:red", label=r"$\Delta V = V_{model} - V_{real}$")
    ax2.axhline(0, color="black", linewidth=0.8)
    ax2.set_ylabel(r"$\Delta V$ (V)")
    ax2.legend()

    ax3 = axes[2]
    ax3.plot(ref["time"], ref["current"], label="Real (mean of 5 runs)", color="tab:blue")
    ax3.plot(sim["time"], -sim["current"], label="Model", color="tab:orange")
    ax3.set_xlabel("Time from electrolysis onset (s)")
    ax3.set_ylabel("Current (A)")
    ax3.legend()

    plt.tight_layout()
    plt.savefig("electrolysis_comparison.png", dpi=200)
    plt.show(
if __name__ == "__main__":
    main()

