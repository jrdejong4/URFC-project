def get_fmu(file_name):
    """Return a local path to an FMU, downloading it from GitHub if missing."""
    local = FMU_DIR / file_name
    if local.is_file():
        return str(local)

    url = FMU_RAW_URL + urllib.parse.quote(file_name)
    print(f"{local} not found, downloading {url}")
    FMU_DIR.mkdir(parents=True, exist_ok=True)
    try:
        urllib.request.urlretrieve(url, local)
    except Exception as exc:
        raise FileNotFoundError(
            f"Could not find {local} and could not download it from {url} ({exc}).\n"
            "Put the .fmu file in the 'fmu' folder next to this script, or adjust "
            "FMU_DIR / FMU_RAW_URL in the settings."
        ) from exc
    return str(local)


def http_get(url):
    """Download a text resource (CSV, JSON) and return it as a string."""
    request = urllib.request.Request(url, headers=HTTP_HEADERS)
    with urllib.request.urlopen(request) as response:
        return response.read().decode("utf-8", errors="ignore")


def save_fig(fig, name, dpi=150):
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    fig.savefig(OUTPUT_DIR / name, dpi=dpi)


def show():
    if SHOW_PLOTS:
        plt.show()
    else:
        plt.close("all")


def get_signal(df, name):
    """Column of `df` that matches `name`: exact match first, then substring.

    The exact match matters: 'p_H2' is also a substring of 'p_H2O'.
    """
    wanted = name.lower()
    for col in df.columns:
        if col.lower() == wanted or col.lower().split(".")[-1] == wanted:
            return df[col]
    for col in df.columns:
        if wanted in col.lower():
            return df[col]
    raise KeyError(
        f"Could not find variable containing '{name}'. "
        f"Available columns: {list(df.columns)}"
    )


def find_column(df, candidates):
    """Name of the first column containing any of the candidate strings."""
    for name in candidates:
        for col in df.columns:
            if name.lower() in col.lower():
                return col
    return None

