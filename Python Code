def load_simulated_polarization():
    """Simulated discharge polarisation curve: (current density A/cm2, voltage V)."""
    sim_path = Path(POLARIZATION_SIM_CSV)
    if not sim_path.exists():
        # Fall back to a result CSV in the current directory
        candidates = sorted(
            f for f in os.listdir(".")
            if f.lower().endswith(".csv") and ("res" in f.lower() or "urfc" in f.lower())
        )
        if candidates:
            sim_path = Path(candidates[0])

    df_sim = pd.read_csv(sim_path)

    if "stack.PEMstack.i_density" in df_sim.columns:
        sim_i = (df_sim["stack.PEMstack.i_density"] / 10000.0).values  # A/m2 -> A/cm2
        sim_v = df_sim["stack.PEMstack.V_cell"].values
    elif "i_A_cm2" in df_sim.columns:
        sim_i = df_sim["i_A_cm2"].values
        sim_v = df_sim["V_cell"].values
    else:
        sim_i = df_sim.iloc[:, 0].values
        sim_v = df_sim.iloc[:, 1].values

    mask = sim_i >= 0  # discharge mode only
    return sim_i[mask], sim_v[mask]


def load_discharge_runs():
    """Low-cost discharge CSV runs from the reference GitHub repository."""
    runs = []

    listing_from_api = True
    try:
        listing = json.loads(http_get(DISCHARGE_API_URL))
        file_names = [item["name"] for item in listing
                      if item["name"].lower().endswith(".csv")]
    except Exception as exc:
        listing_from_api = False
        print(f"Warning: Could not fetch discharge directory via GitHub API ({exc}).")
        file_names = ([f"run_{i}.csv" for i in range(1, 10)]
                      + [f"discharge_{i}.csv" for i in range(1, 10)])

    for fname in file_names:
        try:
            df = pd.read_csv(io.StringIO(http_get(DISCHARGE_BASE_URL + fname)))

            cols = df.columns.tolist()
            i_col = [c for c in cols
                     if any(k in c.lower() for k in ["density", "current", "im", "i"])
                     and "voltage" not in c.lower()][0]
            v_col = [c for c in cols
                     if any(k in c.lower() for k in ["voltage", "vf", "v"])
                     and "current" not in c.lower()][0]

            i_vals = np.abs(df[i_col].values)
            v_vals = df[v_col].values
            if "density" not in i_col.lower():      # total current [A] -> A/cm2
                i_vals = i_vals / CELL_AREA_CM2

            mask = np.isfinite(i_vals) & np.isfinite(v_vals) & (i_vals >= 0)
            if np.sum(mask) > 0:
                order = np.argsort(i_vals[mask])
                runs.append({
                    "name": fname.replace(".csv", ""),
                    "i": i_vals[mask][order],
                    "v": v_vals[mask][order],
                })
        except Exception as exc:
            if listing_from_api:   # with the guessed fallback names, misses are normal
                print(f"Skipped {fname}: {exc}")

    print(f"Loaded {len(runs)} CSV runs for Low-Cost Discharge dataset.")
    return runs


def load_potentiostat_runs():
    """Potentiostat Excel runs from the local csv_output folder."""
    runs = []
    search_dir = POTENTIOSTAT_DIR if os.path.exists(POTENTIOSTAT_DIR) else "./csv_output"

    files = sorted(glob.glob(os.path.join(search_dir, "*.xlsx"))
                   + glob.glob(os.path.join(search_dir, "*.xls")))
    if not files:   # local fallback
        files = sorted(glob.glob("./*.xlsx") + glob.glob("./*.xls"))

    excluded = ["time", "pt", "point", "index", "step", "interval", "date", "sec", "second"]
    current_keys = ["density", "current", "discharge", "im", "a/cm2", "a/cm²", "amp"]
    voltage_keys = ["cell voltage", "voltage", "vf", "volt", "v_cell"]

    for filepath in files:
        basename = os.path.basename(filepath)
        if "res" in basename.lower():   # skip simulation output files
            continue

        try:
            df = pd.read_excel(filepath)
            cols = df.columns.tolist()

            # Ignore time/index-like columns to avoid misidentification
            data_cols = [c for c in cols if not any(ex in c.lower() for ex in excluded)]
            i_col = next((c for c in data_cols
                          if any(k in c.lower() for k in current_keys)), None)
            v_col = next((c for c in data_cols
                          if any(k in c.lower() for k in voltage_keys)), None)

            if not i_col or not v_col:
                print(f"Skipped {basename}: Could not identify valid I or V columns "
                      f"from {cols}")
                continue

            raw_i = np.abs(df[i_col].values)
            v_vals = np.abs(df[v_col].values)

            if np.nanmean(v_vals) > 50.0:    # mV -> V
                v_vals = v_vals / 1000.0

            # Avoid dividing twice if the values are already A/cm2
            already_density = (
                any(u in i_col.lower() for u in ["density", "a/cm2", "a/cm²"])
                or np.nanmax(raw_i) <= 2.0
            )
            i_vals = raw_i if already_density else raw_i / CELL_AREA_CM2

            mask = np.isfinite(i_vals) & np.isfinite(v_vals) & (i_vals >= 0)
            clean_i, clean_v = i_vals[mask], v_vals[mask]

            if len(clean_i) > 0:
                order = np.argsort(clean_i)
                runs.append({
                    "name": basename.rsplit(".", 1)[0],
                    "i": clean_i[order],
                    "v": clean_v[order],
                })
                print(f"Loaded clean Excel run: {basename} "
                      f"({len(clean_i)} points | I: '{i_col}', V: '{v_col}')")
        except Exception as exc:
            print(f"Error loading {filepath}: {exc}")

    print(f"\nLoaded {len(runs)} clean Potentiostat Excel runs.\n")
    return runs


def process_dataset(ref_runs, sim_i, sim_v):
    """Interpolate all reference runs and the simulation onto one current grid."""
    if not ref_runs:
        raise ValueError("No valid reference runs loaded.")

    min_i = max(sim_i.min(), max(r["i"].min() for r in ref_runs if len(r["i"]) > 0))
    max_i = min(sim_i.max(), min(r["i"].max() for r in ref_runs if len(r["i"]) > 0))
    common_i = np.linspace(min_i, max_i, 500)

    interp_v = np.array([
        interp1d(run["i"], run["v"], bounds_error=False, fill_value=np.nan)(common_i)
        for run in ref_runs
    ])
    mean_ref_v = np.nanmean(interp_v, axis=0)

    order = np.argsort(sim_i)
    sim_v_common = interp1d(sim_i[order], sim_v[order],
                            bounds_error=False, fill_value=np.nan)(common_i)

    pointwise_rmse = np.sqrt((sim_v_common - mean_ref_v) ** 2)
    return {
        "i": common_i,
        "ref_v": mean_ref_v,
        "sim_v": sim_v_common,
        "rmse": pointwise_rmse,
        "overall_rmse": np.nanmean(pointwise_rmse),
        "min_i": min_i,
        "max_i": max_i,
    }


def plot_polarization_and_power(style, runs, sim_i, sim_v):
    """Polarisation curve + RMSE, then power density + MPP, for one data set."""
    res = process_dataset(runs, sim_i, sim_v)
    i = res["i"]
    sim_color = "#d62728"

    # --- polarisation curve with pointwise RMSE ---
    fig1, (ax_top, ax_bot) = plt.subplots(
        2, 1, figsize=(9, 7), sharex=True, gridspec_kw={"height_ratios": [3, 1]}
    )
    ax_top.plot(i, res["ref_v"], label=style["ref_label"],
                color=style["color"], linewidth=2.2)
    ax_top.plot(i, res["sim_v"], label="Simulation Model (URFC v2)",
                color=sim_color, linestyle="--", linewidth=2.2)
    ax_top.set_xlim(0, res["max_i"])  
    ax_top.set_ylabel("Cell Voltage (V)", fontsize=11)
    ax_top.set_title(
        f"{style['name']} Dataset: Polarization Curve "
        f"(Shared Range: {res['min_i']:.4f}–{res['max_i']:.4f} A/cm²)",
        fontsize=12, pad=10,
    )
    ax_top.legend(frameon=True, loc="upper right")
    ax_top.grid(True, linestyle=":", alpha=0.6)

    ax_bot.plot(i, res["rmse"] * 1000, color="#2ca02c", linewidth=1.5,
                label=f"Pointwise RMSE (Mean: {res['overall_rmse'] * 1000:.2f} mV)")
    ax_bot.set_xlabel("Current Density ($A/cm^2$)", fontsize=11)
    ax_bot.set_ylabel("RMSE (mV)", fontsize=11)
    ax_bot.legend(frameon=True, loc="upper right")
    ax_bot.grid(True, linestyle=":", alpha=0.6)
    fig1.tight_layout()
    save_fig(fig1, style["polarization_file"], dpi=300)
    show()

    # --- power density and maximum power point ---
    p_ref = res["ref_v"] * i
    p_sim = res["sim_v"] * i
    mpp_ref = np.nanargmax(p_ref)
    mpp_sim = np.nanargmax(p_sim)

    fig2, ax = plt.subplots(figsize=(9, 5.5))
    ax.plot(i, p_ref, label=style["power_ref_label"], color=style["color"], linewidth=2.2)
    ax.plot(i, p_sim, label="Simulation Power Density",
            color=sim_color, linestyle="--", linewidth=2.2)
    ax.scatter([i[mpp_ref]], [p_ref[mpp_ref]], color=style["color"], s=80, zorder=5,
               edgecolor="black",
               label=f"MPP: {p_ref[mpp_ref]:.4f} W/cm² @ {i[mpp_ref]:.3f} A/cm²")
    ax.scatter([i[mpp_sim]], [p_sim[mpp_sim]], color=sim_color, s=80, zorder=5,
               edgecolor="black",
               label=f"MPP: {p_sim[mpp_sim]:.4f} W/cm² @ {i[mpp_sim]:.3f} A/cm²")
    ax.set_xlim(0, res["max_i"])   
    ax.set_xlabel("Current Density ($A/cm^2$)", fontsize=11)
    ax.set_ylabel("Power Density ($W/cm^2$)", fontsize=11)
    ax.set_title(style["power_title"], fontsize=12, pad=10)
    ax.legend(frameon=True, loc="upper left")
    ax.grid(True, linestyle=":", alpha=0.6)
    fig2.tight_layout()
    save_fig(fig2, style["power_file"], dpi=300)
    show()


