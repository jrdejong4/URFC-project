    # Skip simulation output files if present in the same directory
    if "res" in os.path.basename(filepath).lower():
        continue

    try:
        # Read Excel file
        df = pd.read_excel(filepath)
        cols = df.columns.tolist()

        # 1. Exclude time, index, point, and interval columns to prevent misidentification
        data_cols = [
            c
            for c in cols
            if not any(
                ex in c.lower()
                for ex in [
                    "time",
                    "pt",
                    "point",
                    "index",
                    "step",
                    "interval",
                    "date",
                    "sec",
                    "second",
                ]
            )
        ]

        # 2. Strict matching for Current / Current Density column
        i_col = next(
            (
                c
                for c in data_cols
                if any(
                    k in c.lower()
                    for k in [
                        "density",
                        "current",
                        "discharge",
                        "im",
                        "a/cm2",
                        "a/cm²",
                        "amp",
                    ]
                )
            ),
            None,
        )

        # 3. Strict matching for Cell Voltage column
        v_col = next(
            (
                c
                for c in data_cols
                if any(
                    k in c.lower()
                    for k in ["cell voltage", "voltage", "vf", "volt", "v_cell"]
                )
            ),
            None,
        )

        if not i_col or not v_col:
            print(
                f"Skipped {os.path.basename(filepath)}: Could not identify valid I or V columns from {cols}"
            )
            continue

        raw_i = np.abs(df[i_col].values)
        v_vals = np.abs(df[v_col].values)

        # Automatically convert mV to V if raw values are in millivolts
        if np.nanmean(v_vals) > 50.0:
            v_vals = v_vals / 1000.0

        # Smart Scaling: Check if values are already A/cm² to prevent double-division
        is_already_density = (
            any(
                unit in i_col.lower() for unit in ["density", "a/cm2", "a/cm²"]
            )
            or np.nanmax(raw_i) <= 2.0
        )

        if is_already_density:
            i_vals = raw_i
        else:
            i_vals = raw_i / CELL_AREA_CM2

        # Cleaning mask: finite values only, non-negative current density
        mask = np.isfinite(i_vals) & np.isfinite(v_vals) & (i_vals >= 0)
        clean_i = i_vals[mask]
        clean_v = v_vals[mask]

        if len(clean_i) > 0:
            sort_idx = np.argsort(clean_i)
            ref_potentiostat_runs.append(
                {
                    "name": os.path.basename(filepath).rsplit(".", 1)[0],
                    "i": clean_i[sort_idx],
                    "v": clean_v[sort_idx],
                }
            )
            print(
                f"Loaded clean Excel run: {os.path.basename(filepath)} "
                f"({len(clean_i)} points | I: '{i_col}', V: '{v_col}')"
            )
    except Exception as e:
        print(f"Error loading {filepath}: {e}")

print(
    f"\nLoaded {len(ref_potentiostat_runs)} clean Potentiostat Excel runs.\n"
)

# --- 4. Dataset Interpolation Helper ---
def process_dataset(ref_runs, sim_i, sim_v):
    if not ref_runs:
        raise ValueError("No valid reference runs loaded.")

    min_i = max(
        sim_i.min(), max(r["i"].min() for r in ref_runs if len(r["i"]) > 0)
    )
    max_i = min(
        sim_i.max(), min(r["i"].max() for r in ref_runs if len(r["i"]) > 0)
    )

    common_i = np.linspace(min_i, max_i, 500)

    interp_v_matrix = []
    for run in ref_runs:
        f = interp1d(
            run["i"],
            run["v"],
            bounds_error=False,
            fill_value=np.nan,
        )
        interp_v_matrix.append(f(common_i))

    interp_v_matrix = np.array(interp_v_matrix)
    mean_ref_v = np.nanmean(interp_v_matrix, axis=0)

    sort_sim = np.argsort(sim_i)
    f_sim = interp1d(
        sim_i[sort_sim], sim_v[sort_sim], bounds_error=False, fill_value=np.nan
    )
    sim_v_common = f_sim(common_i)

    pointwise_rmse = np.sqrt((sim_v_common - mean_ref_v) ** 2)
    overall_rmse = np.nanmean(pointwise_rmse)

    return (
        common_i,
        mean_ref_v,
        sim_v_common,
        pointwise_rmse,
        overall_rmse,
        min_i,
        max_i,
    )

