    time_local = find_column(df_local, ["time"])
    time_ref = find_column(df_ref, ["time"])
    v_local = find_column(df_local, ["V_model"])
    v_ref = find_column(df_ref, ["Real_V"])
    res_col = find_column(df_local, ["R_load"])

    for name, val in [("time_local", time_local), ("time_ref", time_ref),
                      ("v_local", v_local), ("v_ref", v_ref)]:
        if val is None:
            raise ValueError(f"Column for {name} not found.\n"
                             f"Local columns: {list(df_local.columns)}\n"
                             f"Reference columns: {list(df_ref.columns)}")

    local_win = df_local[(df_local[time_local] >= OCV_T0)
                         & (df_local[time_local] <= OCV_T0 + OCV_WINDOW)].copy()
    local_win["Time_Aligned"] = local_win[time_local] - OCV_T0
    ref_win = df_ref[(df_ref[time_ref] >= 0) & (df_ref[time_ref] <= OCV_WINDOW)].copy()

    # Difference model - reference (nearest reference sample)
    merged = pd.merge_asof(
        local_win.sort_values("Time_Aligned"),
        ref_win.sort_values(time_ref)[[time_ref, v_ref]],
        left_on="Time_Aligned",
        right_on=time_ref,
        direction="nearest",
        suffixes=("", "_ref"),
    )
    v_ref_merged = v_ref + "_ref" if v_ref in local_win.columns else v_ref
    merged["Difference"] = merged[v_local] - merged[v_ref_merged]

    fig, (ax1, ax2, ax3) = plt.subplots(3, 1, figsize=(10, 7), sharex=True)

    ax1.plot(local_win["Time_Aligned"], local_win[v_local], color="#1f77b4", label="Model")
    ax1.plot(ref_win[time_ref], ref_win[v_ref], "--", color="#ff7f0e", label="FC Reference")
    ax1.set_ylabel("Voltage (V)")
    ax1.legend(loc="upper right")

    ax2.plot(merged["Time_Aligned"], merged["Difference"], color="red", label="Difference")
    ax2.set_ylabel("Voltage (V)")
    ax2.legend(loc="upper right")

    if res_col:
        ax3.plot(local_win["Time_Aligned"], local_win[res_col], "--",
                 color="green", label="Resistance")
        ax3.set_ylabel(r"Resistance ($\Omega$)")
        ax3.legend(loc="upper right")
    
    ax3.set_xlim(0, OCV_WINDOW)
    ax3.set_xlabel("Time (s)")
    fig.tight_layout()
    save_fig(fig, "fig5_7_ocv_comparison.png", dpi=200)
    show()

# Figure 5.8 - electrolysis voltage: model vs. mean of 5 measured gas runs

def find_file(name, dirs):
    for d in dirs:
        path = os.path.join(d, name)
        if os.path.isfile(path):
            return path
    return None


def load_electrolysis_sim_csv():
    path = next((p for p in ELECTROLYSIS_SIM_CSV_CANDIDATES if os.path.isfile(p)), None)
    if path is None:
        raise FileNotFoundError(
            "Simulation result CSV not found. Checked: "
            + ", ".join(str(p) for p in ELECTROLYSIS_SIM_CSV_CANDIDATES)
        )
    df = pd.read_csv(path)

    def pick(keywords):
        for col in df.columns:
            if all(k in col.lower() for k in keywords):
                return col
        return None

    time_col = pick(["time"]) or df.columns[0]
    v_col = pick(["v_model"]) or pick(["v_stack"]) or pick(["v_cell"])
    i_col = pick(["i_stack"]) or pick(["current"])

    if v_col is None or i_col is None:
        raise KeyError(
            "Could not find voltage/current columns in sim CSV. "
            f"Available columns: {list(df.columns)}"
        )

    return pd.DataFrame({
        "time": df[time_col].astype(float),
        "voltage": df[v_col].astype(float),
        "current": df[i_col].astype(float),
    })


def load_gasrun(name):
    """One measured gas run: local copy if present, otherwise from GitHub."""
    path = find_file(name, GASRUN_LOCAL_DIRS)
    df = pd.read_csv(path if path is not None else GASRUN_URL_TEMPLATE.format(name=name))
    df = df.rename(columns={"Voltage": "voltage", "Current": "current", "Time": "time"})
    return df[["time", "voltage", "current"]].astype(float)


def align_to_onset(df, threshold=ONSET_THRESHOLD_A):
    """Shift time so that t = 0 is the first sample with |I| > threshold."""
    above = df.index[df["current"].abs() > threshold]
    if len(above) == 0:
        return df
    out = df.copy()
    out["time"] = out["time"] - df.loc[above[0], "time"]
    return out[out["time"] >= 0].reset_index(drop=True)


def average_runs(runs, dt=COMMON_DT):
    """Resample each aligned run onto a common grid and average."""
    t_grid = np.arange(0, min(r["time"].max() for r in runs), dt)

    v_stack = np.full((len(runs), len(t_grid)), np.nan)
    i_stack = np.full((len(runs), len(t_grid)), np.nan)
    for k, r in enumerate(runs):
        v_stack[k] = np.interp(t_grid, r["time"], r["voltage"])
        i_stack[k] = np.interp(t_grid, r["time"], r["current"])

    return pd.DataFrame({
        "time": t_grid,
        "voltage": np.nanmean(v_stack, axis=0),
        "current": np.nanmean(i_stack, axis=0),
    })


def fig_5_8_electrolysis_comparison():
    sim = align_to_onset(load_electrolysis_sim_csv())
    runs = [align_to_onset(load_gasrun(name)) for name in GASRUN_NAMES]
    ref = average_runs(runs)

    t_max = min(sim["time"].max(), ref["time"].max())
    sim = sim[sim["time"] <= t_max]
    ref = ref[ref["time"] <= t_max]

    v_model_interp = np.interp(ref["time"], sim["time"], sim["voltage"])
    v_diff = v_model_interp - ref["voltage"]

    fig, axes = plt.subplots(3, 1, figsize=(8, 10), sharex=True)

    ax1 = axes[0]
    ax1.plot(ref["time"], ref["voltage"], label="Real (mean of 5 runs)", color="tab:blue")
    ax1.plot(sim["time"], sim["voltage"], label="Model", color="tab:orange")
    ax1.set_ylabel("Cell voltage (V)")
    ax1.legend()
    ax1.set_title("Electrolysis voltage: model vs. reference "
                  "(5-run average, Figure 14 comparison)")

    ax2 = axes[1]
    ax2.plot(ref["time"], v_diff, color="tab:red",
             label=r"$\Delta V = V_{model} - V_{real}$")
    ax2.axhline(0, color="black", linewidth=0.8)
    ax2.set_ylabel(r"$\Delta V$ (V)")
    ax2.legend()

    ax3 = axes[2]
    ax3.plot(ref["time"], ref["current"], label="Real (mean of 5 runs)", color="tab:blue")
    ax3.plot(sim["time"], -sim["current"], label="Model", color="tab:orange")
    ax3.set_xlabel("Time from electrolysis onset (s)")
    ax3.set_ylabel("Current (A)")
    ax3.legend()
    ax3.set_xlim(0, t_max)   
    fig.tight_layout()
    save_fig(fig, "electrolysis_comparison.png", dpi=200)
    show()

# Figures 5.9 - 5.11 - URFC FMU: relaxation offset, FC -> EC transition, V-I trace

def fig_5_8_to_5_10_urfc_fmu():
    fmu = get_fmu(FMU_URFC)

    md = read_model_description(fmu)
    available = {v.name for v in md.modelVariables}
    outputs = [n for n in ("V_stack", "I_stack", "V_cell", "V_cell_static")
               if n in available]
    for need in ("V_cell", "V_cell_static"):
        if need not in available:
            raise RuntimeError(f"{need} is not an output of this FMU; "
                               "re-export the full URFC_FMU.")

    # Current profile: FC hold, then step into electrolysis
    t = np.arange(0, URFC_T_END + URFC_DT, URFC_DT)
    u = np.zeros(len(t), dtype=[("time", float), ("I_cmd", float)])
    u["time"] = t
    u["I_cmd"] = np.interp(t, URFC_PROFILE_T, URFC_PROFILE_I)

    r = simulate_fmu(fmu, input=u, stop_time=URFC_T_END,
                     output_interval=URFC_DT, output=outputs)
    tt = r["time"]

    fig1, ax1 = plt.subplots(figsize=(8, 4.5))
    ax1.plot(tt, r["V_cell"] - r["V_cell_static"], color="tab:blue")
    ax1.axhline(0, color="k", lw=0.5)
    ax1.set(title="Relaxation offset (dynamic - static cell voltage)",
            xlabel="time (s)", ylabel="V")
    xlim=(0, URFC_T_END))  
    ax1.grid(alpha=0.3)
    fig1.tight_layout()
    save_fig(fig1, "urfc_1_relaxation_offset.png")

    fig2, ax2 = plt.subplots(figsize=(8, 4.5))
    ax2.plot(tt, r["V_cell"], label="V_cell (dynamic)")
    ax2.plot(tt, r["V_cell_static"], "--", label="V_cell_static (algebraic)")
    ax2.set(xlim=(95, 135), title="Zoom: fuel cell to electrolysis transition",
            xlabel="time (s)", ylabel="V")
    ax2.grid(alpha=0.3)
    ax2.legend()
    fig2.tight_layout()
    save_fig(fig2, "urfc_2_fc_ec_transition.png")

    mask = tt >= T_SKIP_VI
    fig3, ax3 = plt.subplots(figsize=(8, 4.5))
    ax3.plot(r["I_stack"][mask], r["V_stack"][mask], color="tab:blue", lw=1.5)
    ax3.set(title="V-I trace", xlabel="I_stack (A)", ylabel="V_stack (V)")
    ax3.grid(alpha=0.3)
    fig3.tight_layout()
    save_fig(fig3, "urfc_3_vi_trace.png")
    show()

# Figure 5.12 - OpenModelica vs. Simulink FMU

def fig_5_12_openmodelica_vs_simulink():
    om = pd.read_csv(OPENMODELICA_URFC_CSV).drop_duplicates(subset="time", keep="last")
    sim = pd.read_csv(SIMULINK_CSV).drop_duplicates(subset="time", keep="last")

    om_cols = {"V_cell": "urfc.V_cell", "V_cell_static": "urfc.V_cell_static",
               "V_stack": "V_stack", "I_stack": "I_stack"}

    t = np.arange(0, 400.0001, 0.05)

    def om_sig(n):
        return np.interp(t, om["time"], om[om_cols[n]])

    def sim_sig(n):
        return np.interp(t, sim["time"], sim[n])

    # (a) fuel cell -> electrolysis transition
    fig1, ax = plt.subplots(figsize=(8, 4.5))
    ax.plot(t, om_sig("V_cell"), "k", lw=1.8, label="V_cell dynamic (OpenModelica)")
    ax.plot(t, sim_sig("V_cell"), "r--", lw=1.2, label="V_cell dynamic (Simulink FMU)")
    ax.plot(t, om_sig("V_cell_static"), color="tab:gray", lw=1.8,
            label="V_cell static (OpenModelica)")
    ax.plot(t, sim_sig("V_cell_static"), "b:", lw=1.5, label="V_cell static (Simulink FMU)")
    ax.set(xlim=(95, 135), xlabel="time (s)", ylabel="V",
           title="Fuel cell to electrolysis transition: OpenModelica vs Simulink FMU")
    ax.grid(alpha=0.3)
    ax.legend(fontsize=8)
    fig1.tight_layout()
    save_fig(fig1, "align_5_7_transition.png")

    # (b) V-I trace
    m = t >= T_SKIP_VI
    fig2, ax = plt.subplots(figsize=(8, 4.5))
    ax.plot(om_sig("I_stack")[m], om_sig("V_stack")[m], "k", lw=2.0, label="OpenModelica")
    ax.plot(sim_sig("I_stack")[m], sim_sig("V_stack")[m], "r--", lw=1.2,
            label="Simulink FMU")
    ax.set(xlabel="I_stack (A)", ylabel="V_stack (V)",
           title="V-I trace: OpenModelica vs Simulink FMU")
    ax.grid(alpha=0.3)
    ax.legend()
    fig2.tight_layout()
    save_fig(fig2, "align_5_8_vi_trace.png")

    # Agreement between the two tools
    for n in ["V_cell", "V_cell_static", "V_stack", "I_stack"]:
        d = np.abs(om_sig(n) - sim_sig(n))
        print(f"{n:14s} max |diff| = {d.max():.3g}   RMS = {np.sqrt(np.mean(d ** 2)):.3g}")
    show()

